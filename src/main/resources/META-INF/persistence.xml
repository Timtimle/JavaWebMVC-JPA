<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="javawebmvc-jpa" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>vn.edu.hcmute.model.Category</class>
        <class>vn.edu.hcmute.model.User</class>
        <class>vn.edu.hcmute.model.RememberToken</class>
        <class>vn.edu.hcmute.model.EmailOtp</class>
        <class>vn.edu.hcmute.model.Video</class>
        <properties>
            <!-- Preserve the original JDBC URL and Windows authentication. -->
            <property name="jakarta.persistence.jdbc.driver" value="com.microsoft.sqlserver.jdbc.SQLServerDriver" />
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:sqlserver://localhost:14333;databaseName=JavaWebMVC;encrypt=true;trustServerCertificate=true;integratedSecurity=true;" />
            <property name="hibernate.dialect" value="org.hibernate.dialect.SQLServerDialect" />
            <!-- Do not let Hibernate create or change the existing database. -->
            <property name="hibernate.hbm2ddl.auto" value="none" />
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
        </properties>
    </persistence-unit>
</persistence>
